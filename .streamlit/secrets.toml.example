# Copy this file to secrets.toml and fill in what you have. Everything here is optional.

# Bhashini (free, Government of India): voice input AND spoken replies for all 22 languages.
# Register: https://bhashini.gov.in/ulca/user/register  ->  My Profile  ->  Generate API key
BHASHINI_USER_ID = ""
BHASHINI_ULCA_API_KEY = ""

# Google Cloud Speech-to-Text (paid after 60 free minutes/month): optional alternative for voice input
GOOGLE_STT_API_KEY = ""

# data.gov.in daily mandi prices (their API was down when tested)
DATA_GOV_IN_API_KEY = ""
